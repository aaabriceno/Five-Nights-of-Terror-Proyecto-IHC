# Archivos de contexto local para Claude Code (no se comparten en el repo)
CLAUDE.md
PROGRESS.md

# Carpeta de trabajo interna de Claude Code (planes/ledgers de subagentes)
.superpowers/
docs/superpowers/

# Secretos / configuración local (IP real del backend, tokens, etc.)
.env
.env.*
*_local.dart
**/server_config_local.dart

# Configuración de editor personal
.vscode/
.fleet/

# UnityRelay (Python): entorno virtual local, no versionar
UnityRelay/.venv/
__pycache__/
*.pyc
*.pyo

# Unity: paquete embebido de MediaPipe (393MB, binarios nativos + modelos
# .tflite para todas las plataformas) — demasiado pesado para GitHub, ver
# README.md para instrucciones de instalación manual al clonar.
Unity/Packages/com.github.homuler.mediapipe/

# Unity: cache local, logs y archivos generados por el Editor (no versionar)
Unity/Library/
Unity/Logs/
Unity/Temp/
Unity/Obj/
Unity/Build/
Unity/Builds/
Unity/UserSettings/
Unity/MemoryCaptures/
Unity/*.csproj
Unity/*.sln
Unity/.vs/
Unity/.vscode/

# LaTeX (informePresentacionLunes-*): ignorar archivos generados al compilar
# y respaldos; solo se versionan .tex, .pdf e imágenes.
informePresentacionLunes-*/*.aux
informePresentacionLunes-*/*.log
informePresentacionLunes-*/*.nav
informePresentacionLunes-*/*.out
informePresentacionLunes-*/*.snm
informePresentacionLunes-*/*.toc
informePresentacionLunes-*/*.vrb
informePresentacionLunes-*/*.fls
informePresentacionLunes-*/*.fdb_latexmk
informePresentacionLunes-*/*.synctex.gz
informePresentacionLunes-*/*.bak

# LaTeX (informe_final_IHC): mismos archivos generados al compilar
informe_final_IHC/*.aux
informe_final_IHC/*.log
informe_final_IHC/*.out
informe_final_IHC/*.toc
informe_final_IHC/*.fls
informe_final_IHC/*.fdb_latexmk
informe_final_IHC/*.synctex.gz
informe_final_IHC/*.bak
